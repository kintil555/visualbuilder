# ── Discord OAuth ──────────────────────────────────────────────
# Buat app di: https://discord.com/developers/applications
# Di menu OAuth2, tambahkan Redirect URI:
#   http://localhost:3000/api/auth/callback/discord   ← untuk dev
#   https://domain-kamu.com/api/auth/callback/discord ← untuk production
AUTH_DISCORD_ID="isi_client_id_discord_kamu"
AUTH_DISCORD_SECRET="isi_client_secret_discord_kamu"

# ── Auth Secret ────────────────────────────────────────────────
# Generate dengan: openssl rand -base64 32
# Ini juga dipakai untuk sign API token MCP — jangan ganti setelah deploy
# karena semua token yang sudah digenerate akan invalid
AUTH_SECRET="isi_secret_acak_minimal_32_karakter"

# ── URL App (wajib di production, opsional di dev) ─────────────
# Isi dengan URL Cloudflare Workers kamu setelah deploy pertama
# Contoh: https://visual-builder.nama-kamu.workers.dev
# AUTH_URL=https://visual-builder.nama-kamu.workers.dev
